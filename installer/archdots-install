#!/usr/bin/env bash
#
# Install archdots to a disk from the live ISO.
#
# Creates a GPT disk with a 512M EFI system partition and a single ext4 root,
# pacstraps the archdots package set, installs systemd-boot, creates your user
# and then runs the repo's own install.sh to link the configs.
#
#   archdots-install              # interactive
#   archdots-install --dry-run    # show every step, change nothing
#
# THIS ERASES THE DISK YOU SELECT. It refuses to touch the live medium.
set -euo pipefail

REPO_SRC=${ARCHDOTS_SRC:-/usr/share/archdots}
AUR_DIR="$REPO_SRC/aur"
TARGET=/mnt
DRY=0
[ "${1:-}" = "--dry-run" ] && DRY=1

say()  { printf '\n\033[1;35m==> %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m  ok   \033[0m%s\n' "$*"; }
bad()  { printf '\033[1;31m  !!   \033[0m%s\n' "$*"; }
info() { printf '       %s\n' "$*"; }
run()  { if [ "$DRY" -eq 1 ]; then printf '  would run: %s\n' "$*"; else "$@"; fi; }

[ "$(id -u)" -eq 0 ] || { echo "Run as root." >&2; exit 1; }
[ -d "$REPO_SRC/config" ] || { bad "No archdots repo at $REPO_SRC"; exit 1; }

# ------------------------------------------------------------- live medium

# Whatever disk the running ISO came from must never be a target.
live_disk() {
  local src dev
  for src in /run/archiso/bootmnt /run/archiso/airootfs; do
    dev=$(findmnt -no SOURCE --target "$src" 2>/dev/null) || continue
    [ -n "$dev" ] && lsblk -no PKNAME "$dev" 2>/dev/null | head -1 && return
  done
}
LIVE=$(live_disk || true)

# --------------------------------------------------------------- disk pick

say "Available disks"
# MODEL must come last: it often contains spaces, which would shift the field
# TYPE is read from and silently empty the whole listing.
lsblk -dno NAME,SIZE,TYPE,MODEL | awk '$3=="disk"{
  m=""; for (i=4; i<=NF; i++) m = m $i " "
  printf "       /dev/%-12s %-9s %s\n", $1, $2, m
}'
if [ -n "$LIVE" ]; then
  info "(/dev/$LIVE is the live medium and cannot be selected)"
fi

read -rp "
Target disk (e.g. /dev/sda, /dev/nvme0n1): " DISK

# The live medium is never a valid target, dry-run or not.
if [ -n "$LIVE" ] && [ "$DISK" = "/dev/$LIVE" ]; then
  bad "That is the live medium."; exit 1
fi

# A dry run exists to rehearse the flow, which has to work on a machine with no
# spare disk attached. So the device checks warn instead of aborting, and the
# steps that would query the device are skipped.
REAL_DISK=1
if [ ! -b "$DISK" ]; then
  if [ "$DRY" -eq 1 ]; then
    REAL_DISK=0
    bad "$DISK is not a block device -- continuing anyway because this is a dry run"
  else
    bad "$DISK is not a block device"; exit 1
  fi
elif [ "$(lsblk -dno TYPE "$DISK")" != "disk" ]; then
  if [ "$DRY" -eq 1 ]; then
    REAL_DISK=0
    bad "$DISK is not a whole disk -- continuing anyway because this is a dry run"
  else
    bad "$DISK is not a whole disk"; exit 1
  fi
fi

say "This will DESTROY everything on $DISK"
if [ "$REAL_DISK" -eq 1 ]; then
  lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$DISK" | sed 's/^/       /'

  # A disk with mounted partitions is almost certainly a running system rather
  # than an install target. The live medium is caught above, but a second Arch
  # install on a USB stick looks exactly like a disk you meant to erase.
  MOUNTED=$(lsblk -no MOUNTPOINTS "$DISK" | grep -vE '^\s*$' | tr '\n' ' ' || true)
  if [ -n "$MOUNTED" ]; then
    bad "Partitions of $DISK are mounted at: $MOUNTED"
    if [ "$DRY" -eq 1 ]; then
      info "A real run would refuse this disk."
    else
      info "Refusing: this looks like a system that is in use."
      info "Unmount them first if you really mean to erase this disk."
      exit 1
    fi
  fi
else
  info "(no such device, so nothing to show)"
fi
read -rp "
Type the disk path again to confirm: " CONFIRM
[ "$CONFIRM" = "$DISK" ] || { bad "Mismatch; nothing was changed."; exit 1; }

# ------------------------------------------------------------------ prompts

read -rp "Hostname [archdots]: " HOSTNAME; HOSTNAME=${HOSTNAME:-archdots}
read -rp "Username: " USERNAME
[ -n "$USERNAME" ] || { bad "A username is required"; exit 1; }
echo "$USERNAME" | grep -qE '^[a-z_][a-z0-9_-]*$' || { bad "Invalid username"; exit 1; }

while :; do
  read -rsp "Password for $USERNAME: " PW1; echo
  read -rsp "Repeat: " PW2; echo
  [ -n "$PW1" ] && [ "$PW1" = "$PW2" ] && break
  bad "Empty or mismatched; the lock screen ignores empty input, so this must be set."
done

DEFTZ=$(readlink -f /etc/localtime 2>/dev/null | sed 's|.*/zoneinfo/||')
read -rp "Timezone [${DEFTZ:-UTC}]: " TZ; TZ=${TZ:-${DEFTZ:-UTC}}
[ -f "/usr/share/zoneinfo/$TZ" ] || { bad "Unknown timezone $TZ"; exit 1; }

read -rp "Autologin $USERNAME into Hyprland on tty1? [Y/n]: " AL
case "${AL:-y}" in [Nn]*) AUTOLOGIN=0 ;; *) AUTOLOGIN=1 ;; esac

# --------------------------------------------------------------- partition

# nvme/mmc partitions are p1/p2; sd* are 1/2.
case "$DISK" in *[0-9]) P="${DISK}p" ;; *) P="$DISK" ;; esac
ESP="${P}1"; ROOT="${P}2"

say "Partitioning $DISK"
run wipefs -a "$DISK"
if [ "$DRY" -eq 0 ]; then
  sfdisk --quiet --wipe always "$DISK" <<'EOF'
label: gpt
start=1MiB, size=512MiB, type=uefi, name=ESP
start=, size=, type=linux, name=archdots
EOF
fi
run partprobe "$DISK" 2>/dev/null || true
run udevadm settle
ok "GPT: 512M ESP + ext4 root"

say "Creating filesystems"
run mkfs.fat -F32 -n ESP "$ESP"
run mkfs.ext4 -qF -L archdots "$ROOT"

say "Mounting"
run mount "$ROOT" "$TARGET"
run mkdir -p "$TARGET/boot"
run mount "$ESP" "$TARGET/boot"

# ------------------------------------------------------------------ install

say "Installing the base system and the archdots package set"
mapfile -t PKGS < <(grep -vE '^\s*(#|$)' "$REPO_SRC/packages/pacman.txt")
UCODE=()
grep -qi 'AuthenticAMD' /proc/cpuinfo && UCODE=(amd-ucode)
grep -qi 'GenuineIntel' /proc/cpuinfo && UCODE=(intel-ucode)
info "${#PKGS[@]} archdots packages plus base, kernel, firmware and microcode"
run pacstrap -K "$TARGET" base linux linux-firmware "${UCODE[@]}" \
    sudo git vim "${PKGS[@]}"
ok "base system installed"

# AUR packages cannot come from a repo mirror; the ISO carries prebuilt ones.
if compgen -G "$AUR_DIR/*.pkg.tar.zst" >/dev/null; then
  say "Installing the prebuilt AUR packages"
  run mkdir -p "$TARGET/var/cache/archdots-aur"
  run cp "$AUR_DIR"/*.pkg.tar.zst "$TARGET/var/cache/archdots-aur/"
  run arch-chroot "$TARGET" /bin/bash -c \
    'pacman -U --noconfirm --needed /var/cache/archdots-aur/*.pkg.tar.zst'
  run rm -rf "$TARGET/var/cache/archdots-aur"
  ok "$(ls "$AUR_DIR"/*.pkg.tar.zst | wc -l) AUR packages installed"
else
  bad "No prebuilt AUR packages found; theme and weather module will be missing"
fi

say "Writing fstab"
if [ "$DRY" -eq 0 ]; then genfstab -U "$TARGET" > "$TARGET/etc/fstab"; fi

# ----------------------------------------------------------------- configure

say "Configuring the system"
run arch-chroot "$TARGET" ln -sf "/usr/share/zoneinfo/$TZ" /etc/localtime
run arch-chroot "$TARGET" hwclock --systohc
if [ "$DRY" -eq 0 ]; then
  printf 'en_US.UTF-8 UTF-8\n' > "$TARGET/etc/locale.gen"
  printf 'LANG=en_US.UTF-8\n' > "$TARGET/etc/locale.conf"
  printf '%s\n' "$HOSTNAME" > "$TARGET/etc/hostname"
  cat > "$TARGET/etc/hosts" <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   $HOSTNAME.localdomain $HOSTNAME
EOF
fi
run arch-chroot "$TARGET" locale-gen

say "Creating $USERNAME"
run arch-chroot "$TARGET" useradd -m -G wheel -s /usr/bin/fish "$USERNAME"
if [ "$DRY" -eq 0 ]; then
  printf '%s:%s\n' "$USERNAME" "$PW1" | arch-chroot "$TARGET" chpasswd
  printf '%%wheel ALL=(ALL:ALL) ALL\n' > "$TARGET/etc/sudoers.d/10-wheel"
  chmod 440 "$TARGET/etc/sudoers.d/10-wheel"
fi
run arch-chroot "$TARGET" passwd -l root
ok "user created, root login disabled, wheel may sudo with a password"

say "Installing the bootloader"
run arch-chroot "$TARGET" bootctl --esp-path=/boot install
if [ "$DRY" -eq 0 ]; then
  RUUID=$(blkid -s UUID -o value "$ROOT")
  mkdir -p "$TARGET/boot/loader/entries"
  cat > "$TARGET/boot/loader/loader.conf" <<'EOF'
default archdots.conf
timeout 3
console-mode max
editor no
EOF
  {
    printf 'title   archdots\n'
    printf 'linux   /vmlinuz-linux\n'
    [ "${#UCODE[@]}" -gt 0 ] && printf 'initrd  /%s.img\n' "${UCODE[0]}"
    printf 'initrd  /initramfs-linux.img\n'
    printf 'options root=UUID=%s rw\n' "$RUUID"
  } > "$TARGET/boot/loader/entries/archdots.conf"
  info "root=UUID=$RUUID"
fi
ok "systemd-boot installed"

say "Enabling services"
run arch-chroot "$TARGET" systemctl enable NetworkManager
run arch-chroot "$TARGET" systemctl enable power-profiles-daemon
ok "NetworkManager, power-profiles-daemon"

# ------------------------------------------------------------- the dotfiles

say "Installing the dotfiles as $USERNAME"
HOME_DIR="/home/$USERNAME"
run cp -a "$REPO_SRC" "$TARGET$HOME_DIR/archdots"
run rm -rf "$TARGET$HOME_DIR/archdots/aur"
run arch-chroot "$TARGET" chown -R "$USERNAME:$USERNAME" "$HOME_DIR/archdots"

# install.sh refuses to run as root and uses sudo for the dconf defaults, so
# grant passwordless sudo for the duration and take it away afterwards.
if [ "$DRY" -eq 0 ]; then
  printf '%s ALL=(ALL) NOPASSWD: ALL\n' "$USERNAME" > "$TARGET/etc/sudoers.d/99-archdots-install"
  chmod 440 "$TARGET/etc/sudoers.d/99-archdots-install"
fi
run arch-chroot "$TARGET" su - "$USERNAME" -c \
  "cd ~/archdots && ./install.sh --no-packages"
run rm -f "$TARGET/etc/sudoers.d/99-archdots-install"
ok "configs linked into $HOME_DIR/.config (editing them shows as drift in ~/archdots)"

if [ "$AUTOLOGIN" -eq 1 ]; then
  say "Enabling autologin into Hyprland on tty1"
  if [ "$DRY" -eq 0 ]; then
    mkdir -p "$TARGET/etc/systemd/system/getty@tty1.service.d"
    cat > "$TARGET/etc/systemd/system/getty@tty1.service.d/autologin.conf" <<EOF
[Service]
ExecStart=
ExecStart=-/usr/bin/agetty --noreset --noclear --autologin $USERNAME - \$TERM
EOF
    # System-level so it does not end up inside the symlinked repo config.
    mkdir -p "$TARGET/etc/fish/conf.d"
    cat > "$TARGET/etc/fish/conf.d/50-archdots-hyprland.fish" <<'EOF'
# Start the desktop on the first VT only, leaving other TTYs for recovery.
if status is-login; and test -z "$WAYLAND_DISPLAY"; and test "$XDG_VTNR" = 1
    exec start-hyprland
end
EOF
  fi
  ok "tty1 autologin -> start-hyprland"
else
  info "No autologin: log in on a TTY and run start-hyprland"
fi

say "Done"
cat <<EOF

  Installed to $DISK
  user     $USERNAME
  hostname $HOSTNAME

  Reboot and remove the installation medium:
      umount -R $TARGET && reboot

  After first boot:
    * Connect to wifi with: nmcli device wifi connect "SSID" --ask
    * Regenerate the Waybar battery outline for this display:
        ~/archdots/config/waybar/modules/gen-indicator-width.sh
    * Your dotfiles are a git repo at ~/archdots, symlinked into ~/.config.
EOF
